@model Assignment.Models.EmployeeMaster

@{
    ViewData["Title"] = "Edit Employee";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0"><i class="bi bi-pencil-square"></i> Edit Employee</h4>
        </div>

        <div class="card-body">
            <form asp-action="Edit" class="row g-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="EmployeeId" />

                <div class="col-md-6">
                    <label asp-for="EmployeeCode" class="form-label fw-bold"></label>
                    <input asp-for="EmployeeCode" class="form-control" placeholder="Enter employee code" />
                    <span asp-validation-for="EmployeeCode" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="EmployeeName" class="form-label fw-bold"></label>
                    <input asp-for="EmployeeName" class="form-control" placeholder="Enter full name" />
                    <span asp-validation-for="EmployeeName" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Department" class="form-label fw-bold"></label>
                    <input asp-for="Department" class="form-control" placeholder="Enter department" />
                    <span asp-validation-for="Department" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Designation" class="form-label fw-bold"></label>
                    <input asp-for="Designation" class="form-control" placeholder="Enter designation" />
                    <span asp-validation-for="Designation" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="JoiningDate" class="form-label fw-bold"></label>
                    <input asp-for="JoiningDate" class="form-control" type="date" />
                    <span asp-validation-for="JoiningDate" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Salary" class="form-label fw-bold"></label>
                    <input asp-for="Salary" class="form-control" placeholder="Enter salary" />
                    <span asp-validation-for="Salary" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Status" class="form-label fw-bold"></label>
                    <select asp-for="Status" class="form-select">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                    <span asp-validation-for="Status" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="CreatedDate" class="form-label fw-bold"></label>
                    <input asp-for="CreatedDate" class="form-control" type="date" readonly />
                    <span asp-validation-for="CreatedDate" class="text-danger"></span>
                </div>

                <div class="col-12 text-end mt-4">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-save"></i> Save Changes
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4 ms-2">
                        <i class="bi bi-arrow-left-circle"></i> Back to List
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

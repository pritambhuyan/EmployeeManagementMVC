@model Assignment.Models.EmployeeMaster

@{
    ViewData["Title"] = "Create Employee";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0"><i class="bi bi-person-plus"></i> Create New Employee</h4>
        </div>
        <div class="card-body">

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="EmployeeCode" class="form-label fw-bold"></label>
                        <input asp-for="EmployeeCode" class="form-control" placeholder="Enter Employee Code" />
                        <span asp-validation-for="EmployeeCode" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EmployeeName" class="form-label fw-bold"></label>
                        <input asp-for="EmployeeName" class="form-control" placeholder="Enter Employee Name" />
                        <span asp-validation-for="EmployeeName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Department" class="form-label fw-bold"></label>
                        <input asp-for="Department" class="form-control" placeholder="Enter Department" />
                        <span asp-validation-for="Department" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Designation" class="form-label fw-bold"></label>
                        <input asp-for="Designation" class="form-control" placeholder="Enter Designation" />
                        <span asp-validation-for="Designation" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="JoiningDate" class="form-label fw-bold"></label>
                        <input asp-for="JoiningDate" type="date" class="form-control" />
                        <span asp-validation-for="JoiningDate" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Salary" class="form-label fw-bold"></label>
                        <input asp-for="Salary" class="form-control" type="number" placeholder="Enter Salary" />
                        <span asp-validation-for="Salary" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-4 text-end">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-save"></i> Create
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4 ms-2">
                        <i class="bi bi-arrow-left-circle"></i> Back to List
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
